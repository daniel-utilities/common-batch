
::
::  (a<0)  ==  (a>>31&1)
:: (a<=0)  ==  (a-1>>31&1)
::  (a<b)  ==  (a-b>>31&1)
:: (a<=b)  ==  (a-b-1>>31&1)
::
::  (a>0)  ==  (-a>>31&1)
:: (a>=0)  ==  (-a-1>>31&1)
::  (a>b)  ==  (b-a>>31&1)
:: (a>=b)  ==  (b-a-1>>31&1)
::
:: (a==0)  ==  (a>=0) * (a<=0)  ==  (a*a-1>>31&1)
:: (a!=0)  ==  (-a*a>>31&1)
:: (a==b)  ==  ((a-b)*(a-b)-1>>31&1)
:: (a!=b)  ==  ((a-b)*(b-a)>>31&1)
::
:: (a<x<b) ==  ((x-a)*(x-b)>>31&1)
::
:: abs(a)  ==  ((a>=0)*a + (a<0)*-a) == ((a>>31)-(-a>>31))*a
::         ==  (a*(a>>31|1))
